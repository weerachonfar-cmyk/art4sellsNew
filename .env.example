# คัดลอกไฟล์นี้เป็น .env.local เพื่อใช้ในเครื่อง  (ห้าม commit .env / .env.local / ค่าจริง)
# บน Vercel ให้ตั้งค่าเหล่านี้ที่ Project Settings > Environment Variables

# ---- Storage ----
# json  = ไฟล์ backend/data/*.json (Local / งานวิชา)    redis = Upstash Redis (Vercel)
A4S_STORAGE=json

# ---- Email / Developer tools ----
# development = ไม่ส่งอีเมลจริง (พิมพ์ลง console ของ server)   production = ยังไม่มี provider จริง จึงไม่ส่งอีเมล
A4S_EMAIL_MODE=development
# true = เปิด Developer OTP Mailbox (เฉพาะ ADMIN และเฉพาะเมื่อ A4S_EMAIL_MODE=development)  ค่าเริ่มต้นต้องเป็น false
A4S_DEV_TOOLS=false

# ---- Security ----
# origin ของ frontend ถ้าแยกโดเมนกับ API (คั่นด้วย ,)  ว่าง = same-origin เท่านั้น (ใช้ตอน deploy Vercel ที่ frontend/API อยู่โดเมนเดียวกัน)
A4S_CORS_ORIGINS=
A4S_PBKDF2_ITERATIONS=600000
# รหัสผ่านของบัญชี demo (ว่าง = ใช้ค่าเริ่มต้นของ prototype) - บน Vercel ควรตั้งเอง และต้องผ่าน Password Policy
A4S_DEMO_PASSWORD=

# ---- ตัวเลือกเสริม (ปกติไม่ต้องตั้ง) ----
# เชื่อ X-Forwarded-For / X-Forwarded-Proto หรือไม่ (ว่าง = เปิดอัตโนมัติบน Vercel, ปิดในเครื่อง) - อย่าเปิดถ้าไม่ได้อยู่หลัง proxy ที่เชื่อถือได้
A4S_TRUST_PROXY=
# Secure cookie: auto (ตาม HTTPS) / always / never
A4S_COOKIE_SECURE=auto
# ที่เก็บไฟล์ภาพ: ว่าง = เลือกให้ (Vercel -> blob, ในเครื่อง -> local)

A4S_FILE_STORAGE=

# ---- Redis (Upstash) ใช้เมื่อ A4S_STORAGE=redis ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# prefix ของ key (เปลี่ยนเมื่อหลายโปรเจกต์ใช้ฐานข้อมูลเดียวกัน)
A4S_REDIS_PREFIX=a4s:v1

# ---- Vercel Blob (ไฟล์ภาพ) ----
# สร้าง Blob store ชนิด Private แล้วตั้ง token  (ว่าง = อัปโหลดไฟล์ไม่ได้บน Vercel)
BLOB_READ_WRITE_TOKEN=
